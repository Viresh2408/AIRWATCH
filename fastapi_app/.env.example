# Database configuration (SQLite or PostgreSQL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.your-supabase-ref.supabase.co:5432/postgres

# Authentication
JWT_SECRET_KEY=your-secure-random-jwt-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM / AI Insights (Groq API)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Air Quality Station Data (OpenAQ - physical sensors)
OPENAQ_API_KEY=your_openaq_api_key_here

# App settings
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
